# ---------- Pipeline (server-side only; store as GitHub Secrets, never commit) ----------
# LLM enrichment (optional). Without a key the pipeline runs rule-based/extractive only.
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_ARTICLES_PER_RUN=25       # cost cap per run

# Optional extra news source (free tier available). RSS works with no key.
NEWS_API_KEY=

# Optional Supabase mirror (service role key = server only!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Frontend (public, build-time) ----------
NEXT_PUBLIC_BASE_PATH=            # e.g. /lawca for a GitHub project page, empty for custom domain/user page
NEXT_PUBLIC_DATA_MODE=auto        # auto | live | demo
